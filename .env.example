# AccessPilot environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# All AI settings are OPTIONAL. Leave the API key empty to run in
# "deterministic only" mode, which requires no external service.

# --- Uploads -------------------------------------------------------------
# Maximum upload size in megabytes.
ACCESSPILOT_MAX_UPLOAD_MB=25
# Where temporary uploads are written during analysis (created automatically).
ACCESSPILOT_UPLOAD_DIR=.scratch/uploads

# --- AI provider (OpenAI-compatible; Nebius-hosted Nemotron by default) ---
# Enable AI suggestions. Keep false unless you have reviewed the privacy
# implications of sending content to an external inference provider.
ACCESSPILOT_AI_ENABLED=false
# Base URL of the OpenAI-compatible API (no trailing slash).
ACCESSPILOT_AI_BASE_URL=https://api.nebius.ai/llm/v1
# Model identifier to use (must be a model your provider actually serves).
ACCESSPILOT_AI_MODEL=nemotron
# API key. Use the interactive/credential-manager method; do not paste keys
# into chat or source control.
ACCESSPILOT_AI_API_KEY=
# Request timeout in seconds.
ACCESSPILOT_AI_TIMEOUT_SECONDS=60
# Explicit opt-in that you have reviewed the privacy implications and agree
# to transmit the content you choose to include in assistant requests.
# Both ACCESSPILOT_AI_ENABLED and this flag must be true for AI to run.
ACCESSPILOT_AI_USER_CONFIRMED=false

# --- App ------------------------------------------------------------------
ACCESSPILOT_APP_NAME=AccessPilot
ACCESSPILOT_VERSION=0.1.0
# Comma-separated list of allowed CORS origins.
ACCESSPILOT_CORS_ORIGINS=http://localhost:5173
